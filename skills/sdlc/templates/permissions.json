{
  "template": "permissions-fragment 1",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git checkout -b:*)",
      "Bash(git branch:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push origin feature/:*)",
      "Bash(git push -u origin feature/:*)",
      "Bash(git push --set-upstream origin feature/:*)",
      "Bash(git revert:*)",
      "Bash(git merge-base:*)",
      "Bash(git remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git show:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(sdlc-state:*)",
      "Bash(sdlc-check-tickets:*)",
      "Bash(sdlc-check-harness:*)",
      "Bash(sdlc-test-guard:*)",
      "Bash(sdlc-merge-gate:*)",
      "Bash(sdlc-lock:*)",
      "Bash(playwright-cli:*)",
      "Bash(<set me: this project's own test/lint/build command>:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Edit(./**/*.pem)",
      "Edit(./**/id_rsa*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(npm publish:*)",
      "Bash(vercel:*)",
      "Bash(netlify deploy:*)",
      "Bash(fly deploy:*)",
      "Bash(kubectl apply:*)",
      "Bash(terraform apply:*)",
      "Bash(docker push:*)"
    ]
  }
}
